# ── Target / clock ──────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ── Console ─────────────────────────────────────────────────────────────────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash / partition ───────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── ESP PSRAM (policy weights) ────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── ESP-Hosted: P4 host ← SDIO → C5 slave ─────────────────────────────────
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y

# Pick your P4+C5 dev kit in menuconfig if pins differ (e.g. P4-C5 Core Board).
# CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y

# ── Command link: SDIO peer-data (not UART) ─────────────────────────────────
CONFIG_MICRODUCK_CMD_SDIO_ENABLE=y
# robotd [control] defaults
CONFIG_MICRODUCK_CMD_ALPHA=200
CONFIG_MICRODUCK_CMD_HEAD_ALPHA=200

# ── Compiler / WDT ──────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ── IMU ICM-42688 SPI (P4 local) ───────────────────────────────────────────
CONFIG_MICRODUCK_IMU_ENABLE=y
CONFIG_MICRODUCK_IMU_SPI_HOST=2
CONFIG_MICRODUCK_IMU_SPI_SCLK_GPIO=9
CONFIG_MICRODUCK_IMU_SPI_MOSI_GPIO=8
CONFIG_MICRODUCK_IMU_SPI_MISO_GPIO=10
CONFIG_MICRODUCK_IMU_SPI_CS_GPIO=11
CONFIG_MICRODUCK_IMU_SPI_HZ=8000000

# ── Feetech HD1910 / STS (TTL bus on P4) ─────────────────────────────────
CONFIG_MICRODUCK_SERVO_ENABLE=y
CONFIG_MICRODUCK_SERVO_UART_NUM=2
CONFIG_MICRODUCK_SERVO_UART_BAUD=1000000
CONFIG_MICRODUCK_SERVO_TX_GPIO=20
CONFIG_MICRODUCK_SERVO_RX_GPIO=19
CONFIG_MICRODUCK_SERVO_DIR_GPIO=-1
CONFIG_MICRODUCK_SERVO_POSITION_KP=32
CONFIG_MICRODUCK_SERVO_ACTION_SCALE=900
CONFIG_MICRODUCK_SERVO_HEAD_LOWPASS=500
CONFIG_MICRODUCK_SERVO_LEG_LOWPASS=700

# ── Sound: ES8311 codec + NS4150B PA (Waveshare P4-Pico-like defaults) ─────
CONFIG_MICRODUCK_SOUND_ENABLE=y
CONFIG_MICRODUCK_SOUND_HW_ENABLE=y
CONFIG_MICRODUCK_SOUND_I2C_PORT=0
CONFIG_MICRODUCK_SOUND_I2C_SDA_GPIO=7
CONFIG_MICRODUCK_SOUND_I2C_SCL_GPIO=8
CONFIG_MICRODUCK_SOUND_I2C_ADDR=0x18
CONFIG_MICRODUCK_SOUND_I2S_MCLK_GPIO=13
CONFIG_MICRODUCK_SOUND_I2S_BCLK_GPIO=12
CONFIG_MICRODUCK_SOUND_I2S_WS_GPIO=10
CONFIG_MICRODUCK_SOUND_I2S_DOUT_GPIO=9
CONFIG_MICRODUCK_SOUND_PA_GPIO=53
CONFIG_MICRODUCK_SOUND_VOLUME=70
# Note: default IMU SPI pins (8–11) overlap Waveshare audio — remux in menuconfig.

# ── Vision (synthetic frame bus; CSI not wired) ─────────────────────────────
CONFIG_MICRODUCK_VISION_ENABLE=y
CONFIG_MICRODUCK_VISION_WIDTH=160
CONFIG_MICRODUCK_VISION_HEIGHT=120
# CONFIG_MICRODUCK_VISION_CSI_HOOK=y