menu "Microduck ToF (distance / obstacle)"

    config MICRODUCK_TOF_ENABLE
        bool "Enable ToF frame bus + obstacle gate"
        default y
        help
            8×8 depth API matching pollen-robotics/microduck tofd (VL53L8CX).

    config MICRODUCK_TOF_GATE_IN_LOOP
        bool "Apply obstacle gate to cmd twist in 50 Hz loop"
        default y
        depends on MICRODUCK_TOF_ENABLE
        help
            Scale/zero twist.x when ahead < REACT_M / STOP_M (autod-style).

    config MICRODUCK_TOF_ULD
        bool "Compile ST VL53L8CX Ultra Lite Driver (full ranging)"
        default n
        depends on MICRODUCK_TOF_ENABLE
        help
            Vendors the original microduck tof/vendor VL53L8CX ULD (~550 KB
            firmware blob in .rodata) with an ESP-IDF I2C platform. Enable when
            a VL53L8CX is wired and flash budget allows. When off, synthetic/
            inject remains the backend (API surface identical).

    config MICRODUCK_TOF_I2C_PROBE
        bool "Probe / open VL53 on I2C"
        default y
        depends on MICRODUCK_TOF_ENABLE
        help
            Soft presence check always. With MICRODUCK_TOF_ULD, also uploads
            firmware and starts 8×8 ranging at 15 Hz.

    config MICRODUCK_TOF_I2C_PORT
        int "ToF I2C port"
        range 0 1
        default 0
        depends on MICRODUCK_TOF_I2C_PROBE

    config MICRODUCK_TOF_I2C_SDA_GPIO
        int "ToF I2C SDA GPIO"
        range 0 55
        default 7
        depends on MICRODUCK_TOF_I2C_PROBE

    config MICRODUCK_TOF_I2C_SCL_GPIO
        int "ToF I2C SCL GPIO"
        range 0 55
        default 8
        depends on MICRODUCK_TOF_I2C_PROBE

    config MICRODUCK_TOF_I2C_ADDR
        hex "ToF 7-bit I2C address"
        default 0x29
        depends on MICRODUCK_TOF_I2C_PROBE
        help
            VL53L8CX default address is 0x29.

    config MICRODUCK_TOF_RANGE_HZ
        int "ULD ranging frequency (Hz)"
        range 1 15
        default 15
        depends on MICRODUCK_TOF_ULD

endmenu
