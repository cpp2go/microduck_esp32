menu "Microduck IMU (ICM-42688 SPI)"

    config MICRODUCK_IMU_ENABLE
        bool "Probe and use ICM-42688 for policy observations"
        default y
        help
            When enabled, imu::Init() brings up a TDK ICM-42688 (or ICM-42688-P)
            on SPI. Gyro + projected gravity fill obs[0:6] like pollen-robotics
            microduck duck-control ImuData. If init fails, those channels stay
            synthetic and the 50 Hz loop still runs.

    config MICRODUCK_IMU_SPI_HOST
        int "SPI host (2 = SPI2_HOST on ESP32-P4)"
        range 1 3
        default 2
        depends on MICRODUCK_IMU_ENABLE

    config MICRODUCK_IMU_SPI_SCLK_GPIO
        int "SPI SCLK GPIO"
        range 0 55
        default 9
        depends on MICRODUCK_IMU_ENABLE

    config MICRODUCK_IMU_SPI_MOSI_GPIO
        int "SPI MOSI (SDA) GPIO"
        range 0 55
        default 8
        depends on MICRODUCK_IMU_ENABLE

    config MICRODUCK_IMU_SPI_MISO_GPIO
        int "SPI MISO (SDO) GPIO"
        range 0 55
        default 10
        depends on MICRODUCK_IMU_ENABLE

    config MICRODUCK_IMU_SPI_CS_GPIO
        int "SPI CS GPIO"
        range 0 55
        default 11
        depends on MICRODUCK_IMU_ENABLE

    config MICRODUCK_IMU_SPI_HZ
        int "SPI clock Hz"
        range 100000 24000000
        default 8000000
        depends on MICRODUCK_IMU_ENABLE
        help
            ICM-42688 allows up to 24 MHz in SPI mode 0/3; 8 MHz is a safe default
            for short carrier wiring.

endmenu
